{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Cognitive Switchboard v0.1 Record",
  "description": "Structural validation for one switchboard record. This schema does not verify authorization evidence, receipts, lifecycle transitions, or runtime gate decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version", "record_id", "switchboard_id", "subject_agent",
    "status", "requested_state", "authorized_state", "effective_state",
    "requested_by", "authorization", "activated_by", "scope",
    "created_at", "expires_at", "activated_at",
    "human_review_required", "human_review", "bindings",
    "trace_id", "receipt_refs", "reason", "supersedes_ref"
  ],
  "properties": {
    "protocol_version": { "const": "0.1" },
    "record_id": { "$ref": "#/$defs/nonBlankString" },
    "switchboard_id": { "$ref": "#/$defs/nonBlankString" },
    "subject_agent": { "$ref": "#/$defs/nonBlankString" },
    "status": {
      "enum": ["requested", "authorized", "active", "held", "denied", "expired", "revoked", "completed"]
    },
    "requested_state": { "$ref": "#/$defs/switchState" },
    "authorized_state": {
      "anyOf": [{ "$ref": "#/$defs/switchState" }, { "type": "null" }]
    },
    "effective_state": {
      "anyOf": [{ "$ref": "#/$defs/switchState" }, { "type": "null" }]
    },
    "requested_by": { "$ref": "#/$defs/requester" },
    "authorization": {
      "anyOf": [{ "$ref": "#/$defs/authorization" }, { "type": "null" }]
    },
    "activated_by": {
      "anyOf": [{ "$ref": "#/$defs/activator" }, { "type": "null" }]
    },
    "scope": { "$ref": "#/$defs/scope" },
    "created_at": { "$ref": "#/$defs/utcTimestamp" },
    "expires_at": { "$ref": "#/$defs/utcTimestamp" },
    "activated_at": {
      "anyOf": [{ "$ref": "#/$defs/utcTimestamp" }, { "type": "null" }]
    },
    "human_review_required": { "type": "boolean" },
    "human_review": {
      "anyOf": [{ "$ref": "#/$defs/humanReview" }, { "type": "null" }]
    },
    "bindings": { "$ref": "#/$defs/bindings" },
    "trace_id": { "$ref": "#/$defs/nonBlankString" },
    "receipt_refs": { "$ref": "#/$defs/uniqueRefs" },
    "reason": { "$ref": "#/$defs/nonBlankString" },
    "supersedes_ref": { "$ref": "#/$defs/nullableRef" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "requested" } } },
      "then": {
        "properties": {
          "supersedes_ref": { "type": "null" },
          "authorization": { "type": "null" }
        }
      },
      "else": {
        "properties": { "supersedes_ref": { "$ref": "#/$defs/nonBlankString" } }
      }
    },
    {
      "if": { "properties": { "authorization": { "type": "null" } } },
      "then": { "properties": { "authorized_state": { "type": "null" } } },
      "else": { "properties": { "authorized_state": { "$ref": "#/$defs/switchState" } } }
    },
    {
      "if": { "properties": { "status": { "enum": ["authorized", "active", "revoked"] } } },
      "then": { "properties": { "authorization": { "$ref": "#/$defs/authorization" } } }
    },
    {
      "if": { "properties": { "status": { "const": "active" } } },
      "then": {
        "properties": {
          "effective_state": { "$ref": "#/$defs/switchState" },
          "activated_by": { "$ref": "#/$defs/activator" },
          "activated_at": { "$ref": "#/$defs/utcTimestamp" }
        }
      },
      "else": {
        "properties": {
          "effective_state": { "type": "null" },
          "activated_by": { "type": "null" },
          "activated_at": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "enum": ["active", "completed"] } } },
      "then": { "properties": { "receipt_refs": { "minItems": 1 } } }
    },
    {
      "if": {
        "properties": {
          "status": { "enum": ["authorized", "active"] },
          "human_review_required": { "const": true }
        }
      },
      "then": {
        "properties": {
          "human_review": {
            "type": "object",
            "properties": { "decision": { "const": "approved" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonBlankString": { "type": "string", "pattern": "\\S" },
    "nullableRef": {
      "anyOf": [{ "$ref": "#/$defs/nonBlankString" }, { "type": "null" }]
    },
    "uniqueRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonBlankString" },
      "uniqueItems": true
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z(?![\\s\\S])"
    },
    "switchState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory", "external_brain", "reasoning_mode", "question_pack", "human_review_required"],
      "properties": {
        "memory": { "enum": ["OFF", "READ_ONLY", "READ_WRITE"] },
        "external_brain": { "enum": ["OFF", "ON"] },
        "reasoning_mode": { "enum": ["default", "creative", "skeptical", "audit"] },
        "question_pack": { "$ref": "#/$defs/nullableRef" },
        "human_review_required": { "type": "boolean" }
      }
    },
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actor_id"],
      "properties": {
        "kind": { "enum": ["agent", "human", "controller"] },
        "actor_id": { "$ref": "#/$defs/nonBlankString" }
      }
    },
    "activator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actor_id"],
      "properties": {
        "kind": { "const": "controller" },
        "actor_id": { "$ref": "#/$defs/nonBlankString" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "session_id", "resource_refs"],
      "properties": {
        "task_id": { "$ref": "#/$defs/nonBlankString" },
        "session_id": { "$ref": "#/$defs/nonBlankString" },
        "resource_refs": { "$ref": "#/$defs/uniqueRefs" }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id", "kind", "actor_id", "authority_ref",
        "decision_ref", "authorized_at", "valid_until"
      ],
      "properties": {
        "authorization_id": { "$ref": "#/$defs/nonBlankString" },
        "kind": { "enum": ["human", "policy", "controller"] },
        "actor_id": { "$ref": "#/$defs/nonBlankString" },
        "authority_ref": { "$ref": "#/$defs/nonBlankString" },
        "decision_ref": { "$ref": "#/$defs/nonBlankString" },
        "authorized_at": { "$ref": "#/$defs/utcTimestamp" },
        "valid_until": { "$ref": "#/$defs/utcTimestamp" }
      }
    },
    "humanReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_id", "reviewer_id", "decision", "reviewed_at", "valid_until", "evidence_ref"],
      "properties": {
        "review_id": { "$ref": "#/$defs/nonBlankString" },
        "reviewer_id": { "$ref": "#/$defs/nonBlankString" },
        "decision": { "enum": ["approved", "rejected"] },
        "reviewed_at": { "$ref": "#/$defs/utcTimestamp" },
        "valid_until": { "$ref": "#/$defs/utcTimestamp" },
        "evidence_ref": { "$ref": "#/$defs/nonBlankString" }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode_profile_ref", "memory_ref", "external_brain_ref", "question_pack_ref"],
      "properties": {
        "mode_profile_ref": { "$ref": "#/$defs/nullableRef" },
        "memory_ref": { "$ref": "#/$defs/nullableRef" },
        "external_brain_ref": { "$ref": "#/$defs/nullableRef" },
        "question_pack_ref": { "$ref": "#/$defs/nullableRef" }
      }
    }
  }
}
